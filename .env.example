# CUCM target is fixed for the lifetime of an MCP process.
CUCM_HOST=cucm.example.test
CUCM_VERSION=11.5

# Choose exactly one credential source. Provider mode rejects these static fields.
# CUCM_USERNAME=<set-by-your-secret-manager>
# CUCM_PASSWORD=<set-by-your-secret-manager>

# Provider mode: one absolute executable plus separate, non-secret argv values.
# The provider must print exactly {"username":"<username>","password":"<password>"}.
AXL_MCP_CREDENTIAL_PROVIDER='["/absolute/path/to/provider","--asset-id","lab-cucm"]'

# TTL is primary; SIGHUP is optional. Stale credentials are bounded and fail closed.
AXL_MCP_CREDENTIAL_TTL_S=300
AXL_MCP_CREDENTIAL_MAX_STALE_S=0
AXL_MCP_CREDENTIAL_PROVIDER_TIMEOUT_MS=10000
AXL_MCP_CREDENTIAL_REFRESH_ON_SIGHUP=false
