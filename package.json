{
  "name": "@calltelemetry/cisco-axl-mcp",
  "version": "0.10.0",
  "description": "MCP server for Cisco CUCM AXL (SOAP) via cisco-axl",
  "repository": "https://github.com/calltelemetry/cisco-axl-mcp.git",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "cisco-axl-mcp": "build/index.js",
    "cisco-axl-mcp-cli": "build/cli.js"
  },
  "exports": {
    ".": {
      "types": "./build/server.d.ts",
      "default": "./build/server.js"
    },
    "./server": {
      "types": "./build/server.d.ts",
      "default": "./build/server.js"
    },
    "./tools": {
      "types": "./build/tools/index.d.ts",
      "default": "./build/tools.js"
    },
    "./sse": {
      "types": "./build/sse.d.ts",
      "default": "./build/sse.js"
    },
    "./fetch": {
      "types": "./build/fetch.d.ts",
      "default": "./build/fetch.js"
    }
  },
  "files": [
    "build/**/*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate:types": "tsx scripts/generate-types.ts",
    "print:objects": "node -e \"const fs=require('fs'); console.log(fs.readFileSync('generated/axl-top-level-objects.json','utf8'))\"",
    "build": "vite build && tsc -p tsconfig.build.json && chmod 755 build/index.js build/cli.js build/sse.js",
    "start": "node build/index.js",
    "start:sse": "node build/sse.js",
    "dev": "vite build --watch --mode development",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ test/ scripts/",
    "lint:fix": "eslint src/ test/ scripts/ --fix",
    "format": "prettier --write 'src/**/*.ts' 'test/**/*.ts' 'scripts/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'test/**/*.ts' 'scripts/**/*.ts'",
    "test": "vitest run",
    "test:mcp": "vitest run test/mcp-conformance.test.ts",
    "package:smoke": "vitest run test/package-build.test.ts",
    "validate": "yarn typecheck && yarn format:check && yarn lint --max-warnings=0 && yarn vitest run --coverage && yarn build && yarn package:smoke",
    "prepack": "npm run build && npm run test:mcp"
  },
  "keywords": [
    "mcp",
    "cisco",
    "cucm",
    "axl",
    "soap"
  ],
  "author": "CallTelemetry",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cisco-axl": "^2.1.0",
    "dotenv": "^18.0.10",
    "zod": "^4.6.6"
  },
  "resolutions": {
    "@hono/node-server": "2.1.6",
    "@toon-format/toon": "2.3.1",
    "@xmldom/xmldom": "0.8.15",
    "body-parser": "2.4.0",
    "brace-expansion@npm:^1.0.0": "1.1.21",
    "brace-expansion@npm:^5.0.0": "5.0.12",
    "esbuild": "0.28.1",
    "fast-uri": "3.1.9",
    "form-data": "4.0.6",
    "hono": "4.13.16",
    "ip-address": "10.7.4",
    "minimatch": "11.0.1",
    "proxy-addr": "2.0.8",
    "qs": "6.17.1",
    "source-map-js": "1.2.2",
    "tar": "7.5.21",
    "underscore": "1.13.8",
    "undici": "6.29.1",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.4.0",
    "prettier": "^3.8.3",
    "strong-soap": "^6.0.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.0.14",
    "vitest": "^5.0.1"
  },
  "packageManager": "yarn@4.12.0"
}
