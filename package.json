{
  "name": "@calltelemetry/cisco-axl-mcp",
  "version": "0.6.0",
  "description": "MCP server for Cisco CUCM AXL (SOAP) via cisco-axl",
  "repository": "https://github.com/calltelemetry/cisco-axl-mcp.git",
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "bin": {
    "cisco-axl-mcp": "build/index.js",
    "cisco-axl-mcp-cli": "build/cli.js"
  },
  "files": [
    "build/**/*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate:types": "tsx scripts/generate-types.ts",
    "print:objects": "node -e \"const fs=require('fs'); console.log(fs.readFileSync('generated/axl-top-level-objects.json','utf8'))\"",
    "build": "vite build && chmod 755 build/index.js build/cli.js",
    "start": "node build/index.js",
    "dev": "vite build --watch --mode development",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ test/ scripts/",
    "lint:fix": "eslint src/ test/ scripts/ --fix",
    "format": "prettier --write 'src/**/*.ts' 'test/**/*.ts' 'scripts/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'test/**/*.ts' 'scripts/**/*.ts'",
    "test": "vitest run",
    "test:mcp": "vitest run test/mcp-conformance.test.ts",
    "package:smoke": "vitest run test/package-build.test.ts",
    "validate": "yarn typecheck && yarn format:check && yarn lint --max-warnings=0 && yarn vitest run --coverage && yarn build && yarn package:smoke",
    "prepack": "yarn build && yarn test:mcp"
  },
  "keywords": [
    "mcp",
    "cisco",
    "cucm",
    "axl",
    "soap"
  ],
  "author": "CallTelemetry",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cisco-axl": "^2.1.0",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^10.4.0",
    "prettier": "^3.8.3",
    "strong-soap": "^6.0.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  },
  "packageManager": "yarn@4.12.0"
}
